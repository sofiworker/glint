import { Button, ComboBox, LineEdit, ScrollView, Theme, Motion, HorizontalBox, VerticalBox, IconTool } from "@glint_ui/glint-ui.slint";
import { CheckBox } from "std-widgets.slint";
import { GlintIcons } from "@glint_ui/components/icons.slint";
export component RecordingCountdown inherits Window {
    no-frame: true; always-on-top: true;
    width: 68px; height: 68px;
    background: #202124;
    in property <int> seconds;
    Text {
        text: root.seconds;
        color: #ffffff; font-size: 36px; font-weight: 600;
        horizontal-alignment: center; vertical-alignment: center;
    }
}
export component RecordingWindow inherits Window {
    in property <bool> compact;
    out property <length> toolbar-width: 300px;
    out property <length> toolbar-height: 44px;
    no-frame: root.compact;
    in property <image> picture;
    in property <bool> english;
    title: root.english ? "Glint · Recording" : "拾光 · 录屏";
    always-on-top: root.compact || root.active || root.busy;
    preferred-width: root.compact ? root.toolbar-width : 680px; preferred-height: root.compact ? root.toolbar-height : 500px;
    min-width: root.compact ? root.toolbar-width : 320px; min-height: root.compact ? root.toolbar-height : 64px;
    default-font-family: Motion.ui-font-family; default-font-size: Theme.text-body;
    background: Theme.background;
    in property <bool> dark;
    in property <color> accent;
    init => { Theme.apply(root.dark, false, root.accent); }
    changed dark => { Theme.apply(root.dark, false, root.accent); }
    changed accent => { Theme.apply(root.dark, false, root.accent); }
    in property <[string]> sources;
    in-out property <int> source;
    in-out property <int> fps: 1;
    in-out property <int> format: 0;
    // GIF cannot carry audio and tops out at 30 FPS: switching format drops
    // the stale audio flags instead of leaving them hidden-but-armed.
    changed format => {
        if root.format == 1 {
            root.system-audio = false;
            root.microphone = false;
            if root.fps > 1 { root.fps = 1; }
        }
    }
    in-out property <bool> system-audio;
    in-out property <bool> microphone;
    in-out property <bool> cursor: true;
    in-out property <string> directory;
    in property <bool> active;
    in property <bool> busy;
    in property <bool> picking;
    in property <bool> paused;
    in property <bool> can-open;
    in property <bool> can-edit;
    in property <bool> region;
    in property <string> status;
    in property <string> statistics;
    in property <bool> finishing;
    callback action(string);
    if root.compact: Rectangle {
        background: Theme.surface; border-radius: 8px; border-width: 1px; border-color: Theme.line;
        if !root.active && !root.finishing: Text {
            x: 12px; width: parent.width - 57px; height: parent.height;
            text: root.status; color: Theme.ink; font-size: Theme.text-body;
            vertical-alignment: center; overflow: elide;
        }
        HorizontalLayout { padding: 5px; spacing: 4px; alignment: root.finishing ? center : end;
            if root.active: HorizontalLayout {
                width: 72px; horizontal-stretch: 0; spacing: 4px;
                Rectangle { width: 8px; height: 8px; vertical-stretch: 0; background: root.paused ? Theme.muted : Theme.danger; border-radius: 4px; }
                Text {
                    text: root.statistics == "" ? "00:00" : root.statistics;
                    color: Theme.ink; font-family: "Consolas"; font-size: 11px;
                    vertical-alignment: center; horizontal-alignment: left; overflow: elide;
                }
            }
            if root.active: Rectangle { width: 1px; height: 18px; vertical-stretch: 0; background: Theme.line; }
            if root.finishing: Text { text: root.status; color: Theme.muted; vertical-alignment: center; horizontal-alignment: center; overflow: elide; }
            if root.active: Button { width: 64px; height: 32px; text: root.paused ? (root.english ? "Resume" : "继续") : (root.english ? "Pause" : "暂停"); clicked => { root.action("pause"); } }
            if root.active: Button { width: 102px; height: 32px; primary: true; text: root.english ? "Stop & save" : "停止并保存"; clicked => { root.action("stop"); } }
            if !root.finishing: IconTool { width: 32px; icon-only: true; source: GlintIcons.close; label: root.active ? (root.english ? "Discard recording" : "放弃录制") : (root.english ? "Cancel countdown" : "取消倒计时"); clicked => { root.action("cancel"); } }
        }
    }
    if !root.compact && root.can-open: VerticalBox {
        padding: 12px; spacing: 10px;
        HorizontalBox { padding: 0px;
            Text { text: root.english ? "Recording preview" : "录屏预览"; color: Theme.ink; font-size: Theme.text-title; }
            Button { icon: GlintIcons.close; icon-size: 18px; colorize-icon: true; accessible-label: root.english ? "Close preview" : "关闭预览"; clicked => { root.action("close"); } }
        }
        Image { source: root.picture; image-fit: contain; vertical-stretch: 1; }
        Text { text: root.status; color: Theme.muted; wrap: word-wrap; vertical-stretch: 0; }
        HorizontalBox { padding: 0px; spacing: 8px;
            Button { text: root.english ? "Play in system player" : "使用系统播放器播放"; clicked => { root.action("play"); } }
            Button { text: root.english ? "Show saved file" : "查看已保存文件"; clicked => { root.action("open"); } }
            Button { text: root.english ? "Copy video file" : "复制视频文件"; clicked => { root.action("copy"); } }
            Button { text: root.english ? "Edit video…" : "编辑视频…"; primary: true; enabled: root.can-edit; clicked => { root.action("edit"); } }
        }
    }
    if !root.compact && !root.can-open: ScrollView {
        width: parent.width; height: parent.height; content-width: self.visible-width;
        VerticalBox {
            padding: 18px; spacing: 12px; alignment: start;
            Text { text: root.english ? (root.format == 1 ? "Screen recording · GIF" : "Screen recording · MP4") : (root.format == 1 ? "屏幕录制 · GIF" : "屏幕录制 · MP4"); color: Theme.ink; font-size: Theme.text-title; vertical-stretch: 0; }
            if !root.active && !root.busy: VerticalBox {
                padding: 0px; spacing: 10px;
                Text { text: root.english ? "Capture target" : "录制范围"; color: Theme.muted; font-size: Theme.text-caption; }
                ComboBox { model: root.sources; current-index <=> root.source; enabled: !root.picking && !root.region; }
                HorizontalBox { padding: 0px; spacing: 10px;
                    VerticalBox { padding: 0px; spacing: 4px; horizontal-stretch: 1;
                        Text { text: root.english ? "Format" : "格式"; color: Theme.muted; font-size: Theme.text-caption; }
                        ComboBox { model: ["MP4", "GIF"]; current-index <=> root.format; enabled: !root.picking; }
                    }
                    VerticalBox { padding: 0px; spacing: 4px; horizontal-stretch: 1;
                        Text { text: root.english ? "Frame rate" : "帧率"; color: Theme.muted; font-size: Theme.text-caption; }
                        ComboBox { model: ["15 FPS", "30 FPS", "60 FPS", "120 FPS", "144 FPS"]; current-index <=> root.fps; enabled: !root.picking; }
                    }
                    Button { text: root.english ? "Refresh" : "刷新"; enabled: !root.picking; clicked => { root.action("refresh"); } }
                }
                HorizontalBox { padding: 0px; spacing: 14px;
                    CheckBox { text: root.english ? "System audio" : "系统声音"; checked <=> root.system-audio; enabled: !root.picking && root.format == 0; }
                    CheckBox { text: root.english ? "Microphone" : "麦克风"; checked <=> root.microphone; enabled: !root.picking && root.format == 0; }
                    CheckBox { text: root.english ? "Cursor" : "鼠标指针"; checked <=> root.cursor; enabled: !root.picking; }
                }
                Text { text: root.english ? "Save to" : "保存到"; color: Theme.muted; font-size: Theme.text-caption; }
                HorizontalBox {
                    padding: 0px; spacing: 8px;
                    LineEdit { text <=> root.directory; enabled: !root.picking; }
                    Button { text: root.english ? "Browse…" : "浏览…"; enabled: !root.picking; clicked => { root.action("directory"); } }
                }
                Text { text: root.format == 1 ? (root.english ? "GIF · no audio · max 30 seconds" : "GIF · 无声音 · 最长 30 秒") : (root.english ? "High frame rates depend on display and system load." : "高帧率受屏幕刷新率和系统负载影响。"); color: Theme.muted; wrap: word-wrap; }
            }
            Text { text: root.status; color: Theme.ink; wrap: word-wrap; vertical-stretch: 0; }
            if root.active: Text { text: root.statistics; color: Theme.muted; wrap: word-wrap; vertical-stretch: 0; }
            HorizontalBox {
                padding: 0px; spacing: 8px; vertical-stretch: 0;
                if !root.active && !root.busy: Button { text: root.english ? "Start recording" : "开始录屏"; primary: true; enabled: !root.picking && root.sources.length > 0; clicked => { root.action("start"); } }
                if root.active: Button { text: root.paused ? (root.english ? "Resume" : "继续") : (root.english ? "Pause" : "暂停"); clicked => { root.action("pause"); } }
                if root.active: Button { text: root.english ? "Stop and save" : "停止并保存"; primary: true; clicked => { root.action("stop"); } }
                if root.active || root.busy: Button { text: root.english ? "Discard" : "放弃录制"; enabled: !root.picking; clicked => { root.action("cancel"); } }
                if root.can-open: Button { text: root.english ? "Open directory" : "打开保存目录"; clicked => { root.action("open"); } }
            }
        }
    }
}
