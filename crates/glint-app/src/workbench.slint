import { Theme } from "@glint_ui/theme.slint";
import { Motion } from "@glint_ui/widgets/motion.slint";
import { ToolbarAssets } from "@glint_ui/components/toolbar_editor.slint";
import { GlintIcons } from "@glint_ui/components/icons.slint";
import { ComboBox, LineEdit, Slider, ScrollView, SpinBox, CheckBox } from "@glint_ui/widgets/widgets.slint";

export struct EditorLabels {
    clean: string, dirty: string, copy: string, save: string, export: string,
    crop: string, shape: string, text: string, redact: string, adjust: string, clip: string,
    undo: string, redo: string, compare: string, more: string, select: string,
    rect: string, arrow: string, pen: string, highlight: string, solid: string, mosaic: string,
    ratio: string, free: string, rotate: string, flip: string, cancel: string, apply: string,
    brightness: string, contrast: string, saturation: string, reset: string,
    duplicate: string, delete: string, hint: string, fit: string,
    resize: string, objects: string, open: string, close: string, discard: string,
    unsaved: string, unsaved_hint: string, width: string, height: string, linked: string,
    original: string, split: string, play: string, pause: string, audio: string, mute: string,
    from: string, to: string, empty: string, crop_hint: string, text_hint: string,
    frame_back: string, frame_next: string, volume: string, zoom_in: string, zoom_out: string,
    format: string, codec: string, quality: string, fps: string, size: string,
    audio_codec: string, no_audio: string, source_fps: string, export_note: string,
    image_note: string, gif_note: string, webm_note: string, high: string, balanced: string, small: string,
}
export struct EditorObject { label: string, selected: bool }
export struct EditorClip { left: float, wide: float, label: string, selected: bool }
export struct EditorTimedMark { left: float, wide: float, label: string, selected: bool, index: int }
export struct EditorGrip { x: float, y: float }
export struct EditorTooltipProbe { x: float, y: float, text_width: float, text_height: float }
component ToolButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> active;
    in property <bool> primary;
    in property <bool> enabled: true;
    in property <bool> blocked;
    property <bool> can-interact: root.enabled && !root.blocked;
    in property <bool> icon-only;
    forward-focus: keys;
    out property <bool> has-focus: keys.has-focus;
    out property <bool> label-fits: root.icon-only || title.width >= title.preferred-width;
    out property <EditorTooltipProbe> tooltip-probe: { x: (root.absolute-position.x + root.width/2)/1px, y: (root.absolute-position.y + root.height/2)/1px, text_width: title.preferred-width/1px, text_height: title.preferred-height/1px };
    callback clicked;
    callback held(bool);
    height: 32px;
    min-width: root.icon-only ? 32px : title.preferred-width + (root.icon.width > 0 ? 46px : 24px);
    horizontal-stretch: 0;
    border-radius: 6px;
    background: root.primary ? Theme.accent : root.active ? Theme.accent.with-alpha(0.10) : touch.has-hover ? Theme.sidebar : transparent;
    opacity: root.enabled ? 1 : 0.35;
    border-width: keys.has-focus ? 1px : 0px; border-color: Theme.accent;
    accessible-role: button; accessible-label: root.label; accessible-enabled: root.can-interact;
    accessible-action-default => { if root.can-interact { root.clicked(); } }
    icon := Image { visible: root.icon.width > 0; x: root.icon-only ? (parent.width - 18px) / 2 : 10px; y: 7px; width: 18px; height: 18px; source: root.icon; colorize: root.primary ? #fff : root.active ? Theme.accent : Theme.ink; }
    title := Text { visible: !root.icon-only; x: root.icon.width > 0 ? 34px : 12px; width: parent.width - self.x - 12px; height: parent.height; vertical-alignment: center; text: root.label; color: root.primary ? #fff : root.active ? Theme.accent : Theme.ink; }
    keys := FocusScope {
        // The pointer hit target stays above the keyboard focus scope.
        focus-on-click: false;
        enabled: root.can-interact;
        focus-on-tab-navigation: root.can-interact;
        key-pressed(e) => { if root.can-interact && (e.text==Key.Return || e.text==" ") { root.held(true);return accept; } return reject; }
        key-released(e) => { if root.can-interact && (e.text==Key.Return || e.text==" ") { root.held(false);root.clicked();return accept; } return reject; }
    }
    touch := TouchArea { enabled: root.can-interact; mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down { keys.focus();root.held(true); }
            if e.kind == PointerEventKind.cancel || e.kind == PointerEventKind.up { root.held(false); }
        }
    }
    // Slint's input-transparent tooltip popup is rendered above all window
    // content, including later property rows, the canvas, timeline and dialogs.
    if root.icon-only && !root.blocked: Tooltip { text: @markdown("\{root.label}"); }
}
export component WorkbenchWindow inherits Window {
    title: root.filename + " · Glint";
    icon: @image-url("../../../assets/brand/glint-app.svg");
    preferred-width: 1100px; preferred-height: 780px; min-width: 740px; min-height: 540px;
    default-font-family: Motion.ui-font-family; default-font-size: 12px;
    background: Theme.background;
    in property <bool> dark;
    in property <bool> contrast-mode;
    in property <color> accent: #4b5cfa;
    in-out property <bool> reduce-motion <=> Motion.reduced;
    in property <float> interface-scale;
    init => { Theme.apply(root.dark, root.contrast-mode, root.accent); }
    changed dark => { Theme.apply(root.dark,root.contrast-mode,root.accent); }
    changed accent => { Theme.apply(root.dark,root.contrast-mode,root.accent); }
    changed contrast-mode => { Theme.apply(root.dark,root.contrast-mode,root.accent); }
    in property <EditorLabels> labels;
    in property <string> filename;
    in property <bool> dirty;
    in property <bool> busy;
    in property <string> status;
    in property <image> picture;
    in-out property <int> render-ticket;
    in-out property <int> rendered-ticket: -1;
    in property <bool> video;
    in property <bool> playing;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in-out property <int> category: 1;
    in-out property <int> tool;
    in property <color> mark-color: #4b5cfa;
    in-out property <int> line-width: 4;
    in-out property <int> font-size: 40;
    in-out property <int> brightness: 100;
    in-out property <int> contrast: 100;
    in-out property <int> saturation: 100;
    in property <bool> selected;
    in property <float> selected-x;
    in property <float> selected-y;
    in property <float> selected-w;
    in property <float> selected-h;
    in property <[EditorObject]> objects;
    in property <[EditorClip]> clips;
    in property <[EditorTimedMark]> timed-marks;
    in property <[EditorGrip]> grips;
    in property <float> duration;
    in-out property <float> position;
    in property <string> time-label;
    in property <string> media-info;
    in property <float> mark-from;
    in property <float> mark-to;
    in-out property <int> volume: 100;
    in property <bool> muted;
    in property <float> iw: 1;
    in property <float> ih: 1;
    in-out property <bool> comparing;
    in-out property <float> zoom;
    in-out property <length> pan-x;
    in-out property <length> pan-y;
    in-out property <bool> space;
    property <bool> pan-started;
    in-out property <int> modal;
    property <bool> background-active: root.modal == 0 && !root.busy;
    out property <bool> video-layout-fits: !root.video || (stage.height >= 80px && video-toolbar.width >= video-toolbar.min-width && split-button.label-fits && audio-button.label-fits);
    out property <bool> timing-content-fits: !root.video || !root.selected || (timing-from.content-fits && timing-to.content-fits && timing-row.width >= timing-row.min-width);
    // Pointer locations and natural label metrics for rendered tooltip regression.
    out property <[EditorTooltipProbe]> tooltip-probes: [
        undo-button.tooltip-probe, redo-button.tooltip-probe, crop-button.tooltip-probe,
        tool-probe(1), tool-probe(2), tool-probe(3), tool-probe(4), tool-probe(5), tool-probe(6), tool-probe(7), tool-probe(8),
        adjust-button.tooltip-probe, compare-button.tooltip-probe, more-button.tooltip-probe,
        zoom-out-button.tooltip-probe, zoom-in-button.tooltip-probe, fit-button.tooltip-probe,
        frame-back-button.tooltip-probe, play-button.tooltip-probe, frame-next-button.tooltip-probe
    ];
    pure function tool-probe(offset: int) -> EditorTooltipProbe {
        // Repeated tools share a row height; their labels have different widths.
        return { x: crop-button.tooltip-probe.x + offset*36, y: crop-button.tooltip-probe.y, text_width: 0, text_height: crop-button.tooltip-probe.text_height };
    }
    out property <bool> modal-cancel-focused: modal-cancel.has-focus;
    changed modal => {
        root.space=false;
        root.comparing=false;
        if root.modal > 0 { root.more=false;modal-cancel.focus(); }
        else { keys.focus(); }
    }
    changed busy => { if !root.busy && root.modal > 0 { modal-cancel.focus(); } }
    in-out property <bool> more;
    in-out property <int> resize-width;
    in-out property <int> resize-height;
    in-out property <bool> linked: true;
    in-out property <int> export-format;
    changed export-format => { root.export-fps=0;root.export-codec=0; }
    in-out property <int> export-codec;
    in-out property <int> export-quality: 1;
    in-out property <int> export-fps;
    in-out property <int> export-size;
    in-out property <int> export-audio;
    in-out property <int> export-jpeg-quality: 90;
    in property <[string]> export-codecs;
    in property <[int]> export-codec-ids;
    in property <[string]> mov-codecs;
    in property <[int]> mov-codec-ids;
    in property <[string]> mkv-codecs;
    in property <[int]> mkv-codec-ids;
    in property <bool> webm-available;
    in property <bool> encoders-checked;
    in property <string> export-unavailable;
    property <[string]> active-codecs: root.export-format==2 ? root.mov-codecs : root.export-format==3 ? root.mkv-codecs : root.export-codecs;
    property <[int]> active-codec-ids: root.export-format==2 ? root.mov-codec-ids : root.export-format==3 ? root.mkv-codec-ids : root.export-codec-ids;
    in property <string> export-codec-note;
    in property <bool> has-audio;
    property <bool> export-allowed: !root.video || root.export-format==1 || (root.export-format==4 ? root.webm-available : root.active-codec-ids.length > 0);
    in property <bool> text-editing;
    in-out property <string> text-value;
    in property <float> text-x;
    in property <float> text-y;
    in property <float> crop-x;
    in property <float> crop-y;
    in property <float> crop-w;
    in property <float> crop-h;
    in-out property <int> crop-ratio;
    callback action(string);
    callback value(string, float);
    callback pointer(int, float, float, float);
    callback edit-text;
    callback focus-canvas;
    callback focus-text;
    focus-canvas => { if root.modal > 0 { modal-cancel.focus(); } else { keys.focus(); } }
    focus-text => { entry.focus(); }
    function command(a: string) { if !root.busy || a == "escape" { root.action(a); } }
    function magnify(factor: float) {
        root.zoom = max(0.05, min(8, (root.zoom == 0 ? stage.fit : root.zoom) * factor));
    }
    keys := FocusScope {
        width: parent.width; height: parent.height;
        focus-on-tab-navigation: false;
        focus-on-click: root.modal == 0;
        capture-key-pressed(e) => {
            if root.busy {
                if e.text == Key.Escape { root.command("escape"); }
                return accept;
            }
            if root.more && e.text == Key.Escape { root.more = false; return accept; }
            if root.modal > 0 && e.text == Key.Escape { root.command("modal-cancel"); return accept; }
            return reject;
        }
        key-pressed(e) => {
            if root.text-editing { return reject; }
            if e.text == Key.Escape { root.command("escape"); return accept; }
            if root.modal > 0 { return reject; }
            if e.modifiers.control {
                if e.text == "z" || e.text == "Z" { root.command(e.modifiers.shift ? "redo" : "undo"); return accept; }
                if e.text == "y" || e.text == "Y" { root.command("redo"); return accept; }
                if e.text == "c" || e.text == "C" { root.command("copy"); return accept; }
                if e.text == "s" || e.text == "S" { root.command("save"); return accept; }
                if e.text == "o" || e.text == "O" { root.command("open"); return accept; }
                if e.text == "d" || e.text == "D" { root.command("duplicate"); return accept; }
            }
            if e.text == Key.Delete { root.command(root.selected ? "delete" : "delete-clip"); return accept; }
            if e.text == Key.Return && root.category == 0 { root.command("crop-apply"); return accept; }
            if e.text == " " { if !root.space { root.pan-started=false; } root.space=true; return accept; }
            if root.video && e.text == Key.LeftArrow { root.command("frame-back"); return accept; }
            if root.video && e.text == Key.RightArrow { root.command("frame-next"); return accept; }
            return reject;
        }
        key-released(e) => { if root.modal > 0 || root.busy { return accept; } if e.text == " " { root.space=false;if root.video && !root.pan-started { root.command("play"); } return accept; } return reject; }
        VerticalLayout {
            spacing: 0px;
            Rectangle {
                height: 48px; background: Theme.surface;
                HorizontalLayout {
                    y: 8px; height: 32px; width: parent.width;
                    padding-left: 20px; padding-right: 16px; spacing: 12px;
                    Image { width: 24px; height: 24px; vertical-stretch: 0; source: @image-url("../../../assets/brand/glint-app.svg"); }
                    VerticalLayout { spacing: 3px; alignment: center; horizontal-stretch: 1;
                        Text { text: root.filename; color: Theme.ink; font-weight: 600; overflow: elide; }
                        if root.dirty: Text { text: root.labels.dirty; color: Theme.muted; font-size: 10px; }
                    }
                    ToolButton { blocked: !root.background-active; visible: !root.video; label: root.labels.copy; icon: ToolbarAssets.images[12]; icon-only: true; enabled: !root.busy; clicked => { root.command("copy"); } }
                    ToolButton { blocked: !root.background-active; label: root.video ? root.labels.export : root.labels.save; icon: ToolbarAssets.images[11]; primary: true; enabled: !root.busy; clicked => { root.command("save"); } }
                }
            }
            Rectangle { height: 1px; background: Theme.line; }
            Rectangle {
                height: 44px; background: Theme.surface;
                HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 4px;
                    undo-button := ToolButton { blocked: !root.background-active; label: root.labels.undo; icon-only: true; icon: ToolbarAssets.images[9]; enabled: root.can-undo && !root.busy; clicked => { root.command("undo"); } }
                    redo-button := ToolButton { blocked: !root.background-active; label: root.labels.redo; icon-only: true; icon: ToolbarAssets.images[10]; enabled: root.can-redo && !root.busy; clicked => { root.command("redo"); } }
                    Rectangle { horizontal-stretch: 1; }
                    crop-button := ToolButton { blocked: !root.background-active; icon-only: true; label: root.labels.crop; icon: GlintIcons.crop; active: root.category == 0; clicked => { root.command("category:0"); } }
                    for t[i] in [0,1,2,3,4,5,6,7]: ToolButton {
                        blocked: !root.background-active; icon-only: true;
                        label: [root.labels.select, root.labels.rect, root.labels.arrow, root.labels.pen, root.labels.text, root.labels.highlight, root.labels.solid, root.labels.mosaic][i];
                        icon: ToolbarAssets.images[t]; active: root.category >= 1 && root.category <= 3 && root.tool == t;
                        clicked => { root.command("category:" + (t == 4 ? 2 : t >= 6 ? 3 : 1) + ":" + t); }
                    }
                    adjust-button := ToolButton { blocked: !root.background-active; icon-only: true; label: root.labels.adjust; icon: GlintIcons.adjust; active: root.category == 4; clicked => { root.command("category:4"); } }
                    Rectangle { horizontal-stretch: 1; }
                    compare-button := ToolButton { blocked: !root.background-active; label: root.labels.compare; icon: GlintIcons.compare; icon-only: true; active: root.comparing; clicked => {} held(down) => { root.value("compare", down ? 1 : 0); } }
                    more-button := ToolButton { blocked: !root.background-active; label: root.labels.more; icon-only: true; icon: ToolbarAssets.images[14]; clicked => { root.more = !root.more; } }
                }
            }
            Rectangle { height: 1px; background: Theme.line; }
            Rectangle {
                visible: root.category != 1 || root.tool != 0 || root.selected;
                height: !self.visible ? 0px : root.video && root.selected ? 84px : 44px; background: Theme.surface;
                HorizontalLayout { y: 6px; height: 32px; width: parent.width; padding-left: 16px; padding-right: 16px; spacing: 8px;
                    if root.category == 0: HorizontalLayout {
                        spacing: 8px;
                        ComboBox { enabled: root.background-active; width: 104px; model: [root.labels.free,"1:1","4:3","16:9"]; current-index <=> root.crop-ratio; selected(v) => { root.value("ratio", self.current-index); } }
                        ToolButton { blocked: !root.background-active; label: root.labels.rotate; icon: GlintIcons.rotate; clicked => { root.command("rotate"); } }
                        ToolButton { blocked: !root.background-active; label: root.labels.flip; icon: GlintIcons.flip; clicked => { root.command("flip"); } }
                        Rectangle { horizontal-stretch: 1; }
                        ToolButton { blocked: !root.background-active; label: root.labels.cancel; clicked => { root.command("crop-cancel"); } }
                        ToolButton { blocked: !root.background-active; label: root.labels.apply; primary: true; clicked => { root.command("crop-apply"); } }
                    }
                    if root.category == 4: HorizontalLayout {
                        spacing: 14px;
                        for name[i] in [root.labels.brightness,root.labels.contrast,root.labels.saturation]: HorizontalLayout {
                            spacing: 6px;
                            Text { text: name; color: Theme.muted; vertical-alignment: center; }
                            Slider { enabled: root.background-active; min-width: 90px; maximum: 200; value: i==0 ? root.brightness : i==1 ? root.contrast : root.saturation;
                                changed(v) => { root.value(i==0 ? "brightness" : i==1 ? "contrast" : "saturation",v); }
                                released(v) => { root.command("adjust-commit"); }
                            }
                        }
                        ToolButton { blocked: !root.background-active; label: root.labels.reset; clicked => { root.command("adjust-reset"); } }
                    }
                    if root.category == 5: HorizontalLayout {
                        spacing: 10px;
                        Text { text: root.labels.from; color: Theme.muted; vertical-alignment: center; }
                        clip-from := SpinBox { enabled: root.background-active; minimum: 0; maximum: 864000; value: round(root.mark-from * 10); edited(v) => { root.value("from",v/10); } }
                        Text { text: root.labels.to; color: Theme.muted; vertical-alignment: center; }
                        clip-to := SpinBox { enabled: root.background-active; minimum: 1; maximum: 864000; value: round(root.mark-to * 10); edited(v) => { root.value("to",v/10); } }
                        Text { text: "× 0.1 s"; color: Theme.muted; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if root.category == 6: HorizontalLayout {
                        spacing: 10px;
                        ToolButton { blocked: !root.background-active; label: root.labels.mute; icon: GlintIcons.muted; active: root.muted; clicked => { root.command("mute"); } }
                        Text { text: root.labels.volume; color: Theme.muted; vertical-alignment: center; }
                        Slider { enabled: root.background-active; width: 220px; maximum: 200; value: root.volume; changed(v) => { root.value("volume",v); } released(v) => { root.command("adjust-commit"); } }
                        Text { text: root.volume+"%"; color: Theme.muted; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if root.category >= 1 && root.category <= 3: HorizontalLayout {
                        spacing: 6px;
                        for c[i] in [#4b5cfa,#ef5260,#f0b93a,#2ba68b,#202b42,#ffffff]: Rectangle {
                            width: 22px; height: 22px; vertical-stretch: 0; border-radius: 11px; border-width: root.mark-color==c ? 3px : 1px; border-color: root.mark-color==c ? Theme.accent : Theme.line;
                            Rectangle { x: 4px; y: 4px; width: 14px; height: 14px; border-radius: 7px; background: c; }
                            TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.action("color:" + i); } }
                        }
                        if root.category == 1: SpinBox { enabled: root.background-active; width: 76px; minimum: 1; maximum: 48; value: root.line-width; edited(v) => { root.value("line",v); } }
                        if root.category == 2: SpinBox { enabled: root.background-active; width: 76px; minimum: 12; maximum: 48; value: root.font-size; edited(v) => { root.value("font",v); } }
                        Rectangle { horizontal-stretch: 1; }
                        if root.selected: HorizontalLayout {
                            ToolButton { blocked: !root.background-active; label: root.labels.duplicate; clicked => { root.command("duplicate"); } }
                            ToolButton { blocked: !root.background-active; label: root.labels.delete; clicked => { root.command("delete"); } }
                        }
                    }
                }
                timing-row := HorizontalLayout {
                    visible: root.video && root.selected;
                    x: 16px; y: 46px; height: 32px; width: parent.width - 32px; spacing: 8px;
                    Text { text: root.labels.from; color: Theme.muted; vertical-alignment: center; horizontal-stretch: 0; }
                    timing-from := SpinBox { enabled: root.background-active; width: 104px; minimum: 0; maximum: 864000; value: round(root.mark-from*10); edited(v) => { root.value("from",v/10); } }
                    Text { text: root.labels.to; color: Theme.muted; vertical-alignment: center; horizontal-stretch: 0; }
                    timing-to := SpinBox { enabled: root.background-active; width: 104px; minimum: 1; maximum: 864000; value: round(root.mark-to*10); edited(v) => { root.value("to",v/10); } }
                    Text { text: "× 0.1 s"; color: Theme.muted; vertical-alignment: center; horizontal-stretch: 0; }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            Rectangle { height: 1px; background: Theme.line; }
            stage := Rectangle {
                horizontal-stretch: 1; vertical-stretch: 1; clip: true; background: Theme.canvas;
                property <float> fit: max(0.01,min((self.width / 1px-40)/root.iw,(self.height / 1px-40)/root.ih));
                property <float> unit: root.zoom==0 ? self.fit : root.zoom;
                property <length> ix: (self.width - root.iw*self.unit*1px)/2+root.pan-x;
                property <length> iy: (self.height - root.ih*self.unit*1px)/2+root.pan-y;
                Image { x: stage.ix; y: stage.iy; width: root.iw*stage.unit*1px; height: root.ih*stage.unit*1px; source: root.picture; image-fit: fill; }
                if root.selected && !root.comparing && root.category != 0 && !root.text-editing: Rectangle {
                    x: stage.ix+root.selected-x*stage.unit*1px; y: stage.iy+root.selected-y*stage.unit*1px;
                    width: root.selected-w*stage.unit*1px; height: root.selected-h*stage.unit*1px; border-width: 1px; border-color: Theme.accent;
                }
                for p in root.grips: Rectangle {
                    visible: root.selected && !root.comparing && root.category!=0 && !root.text-editing;
                    x: stage.ix+p.x*stage.unit*1px - 3px; y: stage.iy+p.y*stage.unit*1px - 3px;
                    width: 6px; height: 6px; background: Theme.surface; border-width: 1px; border-color: Theme.accent;
                }
                if root.category == 0 && !root.comparing: Rectangle {
                    x: stage.ix+root.crop-x*stage.unit*1px; y: stage.iy+root.crop-y*stage.unit*1px;
                    width: root.crop-w*stage.unit*1px; height: root.crop-h*stage.unit*1px;
                    border-width: 1px; border-color: #ffffff;
                    Rectangle { x: 0px; y: -stage.iy - root.crop-y*stage.unit*1px; width: parent.width; height: root.crop-y*stage.unit*1px+stage.iy; background: #0006; }
                    Rectangle { y: parent.height; x: 0px; width: parent.width; height: stage.height; background: #0006; }
                    Rectangle { x: -stage.width; y: -stage.height; width: stage.width; height: stage.height*3; background: #0006; }
                    Rectangle { x: parent.width; y: -stage.height; width: stage.width; height: stage.height*3; background: #0006; }
                    for p in [{x:0,y:0},{x:1,y:0},{x:0,y:1},{x:1,y:1}]: Rectangle { x: p.x*parent.width - 4px; y: p.y*parent.height - 4px; width: 8px; height: 8px; background: #fff; }
                    for k in [1,2]: Rectangle { x: parent.width*k/3; width: 1px; height: parent.height; background: #fff4; }
                    for k in [1,2]: Rectangle { y: parent.height*k/3; height: 1px; width: parent.width; background: #fff4; }
                }
                canvas := TouchArea {
                    enabled: !root.busy && root.modal==0 && !root.text-editing;
                    mouse-cursor: root.space ? grab : root.tool == 0 ? default : crosshair;
                    property <length> down-x; property <length> down-y;
                    property <length> old-x; property <length> old-y; property <bool> panning;
                    scroll-event(e) => { root.magnify(e.delta-y>0px ? 1.12 : 1/1.12); return accept; }
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.cancel { self.panning=false; root.pointer(3,0,0,stage.unit); }
                        if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                            keys.focus();root.more=false;self.panning=root.space;if self.panning { root.pan-started=true; }
                            self.down-x=self.mouse-x;self.down-y=self.mouse-y;self.old-x=root.pan-x;self.old-y=root.pan-y;
                            if !self.panning { root.pointer(0,(self.mouse-x - stage.ix)/1px/stage.unit,(self.mouse-y - stage.iy)/1px/stage.unit,stage.unit); }
                        }
                        if e.kind == PointerEventKind.move && self.pressed {
                            if self.panning { root.pan-x=self.old-x+self.mouse-x - self.down-x;root.pan-y=self.old-y+self.mouse-y - self.down-y; }
                            else { root.pointer(1,(self.mouse-x - stage.ix)/1px/stage.unit,(self.mouse-y - stage.iy)/1px/stage.unit,stage.unit); }
                        }
                        if e.button == PointerEventButton.left && e.kind == PointerEventKind.up {
                            if !self.panning { root.pointer(2,(self.mouse-x - stage.ix)/1px/stage.unit,(self.mouse-y - stage.iy)/1px/stage.unit,stage.unit); }
                            self.panning=false;
                        }
                    }
                    double-clicked => { root.edit-text(); }
                }
                entry := LineEdit { enabled: root.background-active;
                    visible: root.text-editing;
                    x: max(0px,min(stage.width - 240px,stage.ix+root.text-x*stage.unit*1px));
                    y: max(0px,min(stage.height - 38px,stage.iy+root.text-y*stage.unit*1px));
                    width: min(400px,stage.width - self.x); height: 38px;
                    text <=> root.text-value;
                    accepted => { root.command("text-commit"); }
                    key-pressed(e) => { if e.text==Key.Escape { root.command("text-cancel"); return accept; } return reject; }
                }
                if root.comparing: Text { x: 16px; y: 14px; text: root.labels.original; color: Theme.accent; }
                if root.status != "": Rectangle {
                    x: 12px; y: parent.height - 38px; width: parent.width - 24px; height: 30px; background: Theme.surface; border-radius: 5px;
                    Text { x: 10px; width: parent.width - 20px; height: parent.height; text: root.status; color: Theme.ink; vertical-alignment: center; overflow: elide; }
                }
            }
            Rectangle {
                height: 36px;
                background: Theme.background;
                HorizontalLayout { padding-left: 16px; padding-right: 12px; spacing: 6px;
                    Text { text: root.media-info; color: Theme.muted; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    zoom-out-button := ToolButton { blocked: !root.background-active; label: root.labels.zoom-out; icon: GlintIcons.minus; icon-only: true; clicked => { root.magnify(1/1.2); } }
                    ToolButton { blocked: !root.background-active; label: root.zoom==0 ? root.labels.fit : round(root.zoom*100)+"%"; clicked => { root.zoom=1;root.pan-x=0px;root.pan-y=0px; } }
                    zoom-in-button := ToolButton { blocked: !root.background-active; label: root.labels.zoom-in; icon: GlintIcons.plus; icon-only: true; clicked => { root.magnify(1.2); } }
                    fit-button := ToolButton { blocked: !root.background-active; label: root.labels.fit; icon: GlintIcons.fit; icon-only: true; clicked => { root.zoom=0;root.pan-x=0px;root.pan-y=0px; } }
                }
            }
            Rectangle {
                visible: root.video;
                height: root.video ? 184px : 0px; background: Theme.surface;
                Rectangle { height: 1px; background: Theme.line; }
                video-toolbar := HorizontalLayout { x: 16px; y: 8px; width: parent.width - 32px; height: 32px; spacing: 8px;
                    split-button := ToolButton { blocked: !root.background-active; label: root.labels.split; icon: GlintIcons.split; clicked => { root.command("split"); } }
                    ToolButton { blocked: !root.background-active; label: root.labels.delete; icon: GlintIcons.trash; icon-only: true; clicked => { root.command("delete-clip"); } }
                    ToolButton { blocked: !root.background-active; label: root.labels.clip; icon: GlintIcons.clip; icon-only: true; active: root.category == 5; clicked => { root.command("category:5"); } }
                    Rectangle { horizontal-stretch: 1; }
                    frame-back-button := ToolButton { blocked: !root.background-active; label: root.labels.frame-back; icon: GlintIcons.frame-back; icon-only: true; clicked => { root.command("frame-back"); } }
                    play-button := ToolButton { blocked: !root.background-active; label: root.playing ? root.labels.pause : root.labels.play; icon: root.playing ? GlintIcons.pause : GlintIcons.play; icon-only: true; clicked => { root.command("play"); } }
                    frame-next-button := ToolButton { blocked: !root.background-active; label: root.labels.frame-next; icon: GlintIcons.frame-next; icon-only: true; clicked => { root.command("frame-next"); } }
                    Text { text: root.time-label; color: Theme.muted; vertical-alignment: center; horizontal-stretch: 0; }
                    Rectangle { horizontal-stretch: 1; }
                    audio-button := ToolButton { blocked: !root.background-active; label: root.labels.audio; icon: root.muted ? GlintIcons.muted : GlintIcons.audio; active: root.category==6; clicked => { root.command("category:6"); } }
                }
                timeline := Rectangle {
                    x: 24px; y: 52px; width: parent.width - 48px; height: 88px;
                    background: Theme.background; border-radius: 4px;
                    TouchArea {
                        height: 16px; enabled: root.background-active;
                        moved => { if self.pressed { root.value("seek", max(0,min(1,self.mouse-x / self.width)) * root.duration); } }
                        clicked => { root.value("seek", max(0,min(1,self.mouse-x / self.width)) * root.duration); }
                    }
                    for c[i] in root.clips: Rectangle {
                        x: c.left*parent.width; y: 16px; width: max(2px,c.wide*parent.width - 3px); height: 40px; border-radius: 4px;
                        background: c.selected ? Theme.accent.with-alpha(0.18) : Theme.sidebar;
                        border-width: 1px; border-color: c.selected ? Theme.accent : Theme.line;
                        Text { x: 8px; width: parent.width - 12px; height: parent.height; text: c.label; color: Theme.ink; overflow: elide; vertical-alignment: center; }
                        TouchArea { clicked => { root.action("clip:"+i); } }
                    }
                    for m in root.timed-marks: Rectangle {
                        x: m.left*parent.width; y: 64px; width: max(2px,m.wide*parent.width - 2px); height: 18px;
                        border-radius: 3px; background: Theme.accent.with-alpha(m.selected ? 0.4 : 0.16);
                        clip: true;
                        Text { x: min(6px, parent.width); width: max(0px, parent.width - 8px); height: parent.height; text: m.label; color: Theme.ink; font-size: 10px; overflow: elide; vertical-alignment: center; }
                        TouchArea { clicked => { root.action("object:"+m.index); } }
                    }
                    Rectangle { x: root.position/max(0.01,root.duration)*parent.width; width: 1px; height: parent.height; background: Theme.accent; }
                }
                Slider { enabled: root.background-active; x: 18px; y: 144px; width: parent.width - 36px; maximum: max(0.01,root.duration); value: root.position; changed(v) => { root.value("seek",v); } }
            }
        }
        if root.more: TouchArea { clicked => { root.more = false; } }
        if root.more: Rectangle {
            x: parent.width - 242px; y: 94px; width: 226px; height: 126px; background: Theme.surface; border-width: 1px; border-color: Theme.line; border-radius: 8px;
            VerticalLayout { padding: 8px; spacing: 2px;
                ToolButton { blocked: !root.background-active; label: root.labels.resize; clicked => { root.more=false;root.command("resize-dialog"); } }
                ToolButton { blocked: !root.background-active; label: root.labels.objects; clicked => { root.more=false;root.modal=3; } }
                ToolButton { blocked: !root.background-active; label: root.labels.open; clicked => { root.more=false;root.command("open"); } }
            }
        }
        Rectangle {
            visible: root.modal > 0;
            width: parent.width; height: parent.height;
            background: #0004;
            TouchArea { }
            Rectangle {
                x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                width: root.modal==4 ? 500px : 440px; height: root.modal==4 ? (root.video ? (root.export-format!=1 ? min(436px,root.height - 32px) : 258px) : (root.export-format==1 ? 272px : 228px)) : root.modal==3 ? 360px : 236px; background: Theme.surface; border-radius: 10px; border-width: 1px; border-color: Theme.line;
                VerticalLayout { padding: 24px; spacing: root.modal==4 ? 12px : 16px;
                    Text { text: root.modal==4 ? (root.video ? root.labels.export : root.labels.save) : root.modal==1 ? root.labels.unsaved : root.modal==2 ? root.labels.resize : root.labels.objects; font-size: 16px; font-weight: 600; color: Theme.ink; }
                    if root.modal==1: Text { text: root.labels.unsaved_hint; wrap: word-wrap; color: Theme.muted; }
                    if root.modal==2: HorizontalLayout {
                        spacing: 12px;
                        Text { text: root.labels.width; color: Theme.muted; vertical-alignment: center; }
                        SpinBox { minimum: 1; maximum: 16384; value: root.resize-width; edited(v) => { root.value("resize-width",v); } }
                        Text { text: root.labels.height; color: Theme.muted; vertical-alignment: center; }
                        SpinBox { minimum: 1; maximum: 16384; value: root.resize-height; edited(v) => { root.value("resize-height",v); } }
                    }
                    if root.modal==2: CheckBox { text: root.labels.linked; checked <=> root.linked; }
                    if root.modal==3: ScrollView {
                        for obj[i] in root.objects: ToolButton { y: i*36px; width: parent.width; label: obj.label; active: obj.selected; clicked => { root.action("object:"+i);root.modal=0; } }
                        if root.objects.length==0: Text { text: root.labels.empty; color: Theme.muted; }
                    }
                    if root.modal==4: VerticalLayout {
                        spacing: 12px;
                        HorizontalLayout { spacing: 12px;
                            Text { width: 72px; text: root.labels.format; color: Theme.muted; vertical-alignment: center; }
                            ComboBox { enabled: !root.busy; model: root.video ? ["MP4", "GIF", "MOV", "MKV", "WebM"] : ["PNG", "JPEG", "WebP", "BMP", "TIFF"]; current-index <=> root.export-format; }
                        }
                        HorizontalLayout { spacing: 12px;
                            Text { width: 72px; text: root.labels.size; color: Theme.muted; vertical-alignment: center; }
                            ComboBox { enabled: !root.busy; model: ["100%", "75%", "50%", "25%"]; current-index <=> root.export-size; }
                        }
                        if root.video && root.export-format!=1: HorizontalLayout { spacing: 12px;
                            Text { width: 72px; text: root.labels.codec; color: Theme.muted; vertical-alignment: center; }
                            if root.export-format!=4: ComboBox { enabled: !root.busy && root.active-codec-ids.length>0; model: root.active-codecs; current-index <=> root.export-codec; }
                            if root.export-format==4: Text { text: "VP9"; color: Theme.ink; vertical-alignment: center; }
                        }
                        if root.video && root.export-format!=1: HorizontalLayout { spacing: 12px;
                            Text { width: 72px; text: root.labels.quality; color: Theme.muted; vertical-alignment: center; }
                            ComboBox { enabled: !root.busy; model: [root.labels.high,root.labels.balanced,root.labels.small]; current-index <=> root.export-quality; }
                        }
                        if !root.video && root.export-format==1: HorizontalLayout { spacing: 12px;
                            Text { width: 72px; text: root.labels.quality; color: Theme.muted; vertical-alignment: center; }
                            SpinBox { enabled: !root.busy; minimum: 1; maximum: 100; value <=> root.export-jpeg-quality; }
                        }
                        if root.video: HorizontalLayout { spacing: 12px;
                            Text { width: 72px; text: root.labels.fps; color: Theme.muted; vertical-alignment: center; }
                            ComboBox { enabled: !root.busy; model: root.export-format==1 ? [root.labels.source_fps,"30 FPS","24 FPS","15 FPS","10 FPS"] : [root.labels.source_fps,"60 FPS","30 FPS","24 FPS","15 FPS","10 FPS"]; current-index <=> root.export-fps; }
                        }
                        if root.video && root.export-format!=1: HorizontalLayout { spacing: 12px;
                            Text { width: 72px; text: root.labels.audio_codec; color: Theme.muted; vertical-alignment: center; }
                            if root.has-audio: ComboBox { enabled: !root.busy; model: root.export-format==4 ? ["Opus · 192 kbps","Opus · 128 kbps","Opus · 256 kbps",root.labels.no_audio] : ["AAC · 192 kbps","AAC · 128 kbps","AAC · 256 kbps",root.labels.no_audio]; current-index <=> root.export-audio; }
                            if !root.has-audio: Text { text: root.labels.no_audio; color: Theme.muted; vertical-alignment: center; }
                        }
                        if root.video && root.export-format!=1: Text { text: root.export-allowed || !root.encoders-checked ? root.export-codec-note : root.export-unavailable; color: Theme.muted; wrap: word-wrap; font-size: 11px; }

                    }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout { spacing: 8px; alignment: end;
                        modal-cancel := ToolButton { enabled: !root.busy; label: root.modal==3 ? root.labels.close : root.labels.cancel; clicked => { root.command("modal-cancel"); } }
                        if root.modal==1: ToolButton { label: root.labels.discard; clicked => { root.command("discard"); } }
                        if root.modal==1: ToolButton { label: root.video ? root.labels.export : root.labels.save; primary: true; clicked => { root.command("save-leave"); } }
                        if root.modal==2: ToolButton { label: root.labels.apply; primary: true; clicked => { root.command("resize-apply"); } }
                        if root.modal==4: ToolButton { label: root.video ? root.labels.export : root.labels.save; primary: true; enabled: !root.busy && root.export-allowed; clicked => { root.command("export-confirm"); } }
                    }
                }
            }
        }
    }
}

export component CaptureResultWindow inherits Window {
    in property <string> ui-font-family;
    no-frame: true; always-on-top: true;
    preferred-width: 244px; preferred-height: 194px;
    default-font-family: root.ui-font-family; default-font-size: 11px;
    background: Theme.surface;
    in property <bool> dark; in property <bool> contrast-mode; in property <color> accent: #4b5cfa;
    in property <float> interface-scale;
    in-out property <bool> reduce-motion <=> Motion.reduced;
    init => { Theme.apply(root.dark,root.contrast-mode,root.accent); }
    changed dark => { Theme.apply(root.dark,root.contrast-mode,root.accent); }
    changed accent => { Theme.apply(root.dark,root.contrast-mode,root.accent); }
    changed contrast-mode => { Theme.apply(root.dark,root.contrast-mode,root.accent); }
    in property <image> picture;
    in property <string> message;
    in property <string> hint;
    in property <string> kind;
    callback open;
    callback dismiss;
    Rectangle { border-width: 1px; border-color: Theme.line; border-radius: 8px;
        Text { x: 14px; y: 12px; text: root.message; color: Theme.muted; }
        Image { x: 12px; y: 38px; width: parent.width - 24px; height: 114px; source: root.picture; image-fit: contain; }
        Text { x: 14px; y: 166px; text: root.kind; color: Theme.muted; }
        Text { x: parent.width - 126px; y: 166px; width: 112px; height: 18px; text: root.hint; color: Theme.accent; horizontal-alignment: right; }
        TouchArea { mouse-cursor: pointer; clicked => { root.open(); } }
        ToolButton { x: parent.width - 36px; y: 4px; width: 32px; height: 28px; label: "×"; icon-only: true; icon: ToolbarAssets.images[13]; clicked => { root.dismiss(); } }
    }
}
