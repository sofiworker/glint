        { label: root.labels.rectangle, tool: 3, action: "", enabled: !root.busy },
        { label: root.labels.arrow, tool: 4, action: "", enabled: !root.busy },
        { label: root.labels.pen, tool: 2, action: "", enabled: !root.busy },
        { label: root.labels.text, tool: 8, action: "", enabled: !root.busy },
        { label: root.labels.highlight, tool: 5, action: "", enabled: !root.busy },
        { label: root.labels.redact, tool: 1, action: "", enabled: !root.busy },
        { label: root.labels.pixelate, tool: 7, action: "", enabled: !root.busy },
        { label: root.labels.picker, tool: 6, action: "", enabled: !root.busy },
        { label: root.labels.undo, tool: -1, action: "undo", enabled: !root.busy && root.can-undo },
