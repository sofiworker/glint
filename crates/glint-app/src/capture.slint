    out property <length> toolbar-hint-x: max(4px, min(root.hint-button-x, root.width - toolbar-hint.width - 4px));
    out property <length> toolbar-hint-y: max(4px, min(root.hint-button-y >= 32px ? root.hint-button-y - 28px : root.hint-button-y + root.row-height, root.height - 28px));
    out property <length> toolbar-height: root.color-only ? 42px : min(root.toolbar-content-height, root.toolbar-layout == 0 ? min(root.toolbar-grid-rows * root.row-height + 10px, max(44px, root.height - 220px)) : root.toolbar-content-height) + ((root.toolbar-layout == 1 || root.toolbar-layout == 3) && root.toolbar-content-width > root.toolbar-width ? 12px : 0px);
    property <bool> compact: root.toolbar-width < 520px;
