    out property <length> toolbar-width: root.single-row && !root.color-only ? max(1, floor((root.toolbar-requested-width - 12px) / root.cell-width)) * root.cell-width + 12px : root.toolbar-requested-width;
    changed toolbar-scroll-x => {
