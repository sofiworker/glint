    out property <bool> toolbar-hint-visible: root.selected && !root.color-only && root.background-active && root.toolbar-modal == 0 && root.toolbar-hint-index >= 0 && root.toolbar-hint-index < root.toolbar-items.length && root.actions[root.toolbar-items[root.toolbar-hint-index]].enabled;
