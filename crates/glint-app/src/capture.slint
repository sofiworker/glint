    out property <length> toolbar-y: root.color-only ? max(12px,root.height - root.toolbar-total-height - 12px) : root.toolbar-position == 1 ? root.safe-top : root.toolbar-position == 2 ? max(12px, root.height - root.toolbar-total-height - 12px) : max(root.safe-top, min(root.below + root.toolbar-total-height <= root.height - 12px ? root.below : root.above >= 70px ? root.above : root.height - root.toolbar-total-height - 12px, root.height - root.toolbar-total-height - 12px));
    property <[CaptureAction]> actions: [
