export struct ObjectGrip { x: float, y: float }
export struct CaptureLabels { color-picker: string, magnifier: string, pin: string, save-elsewhere: string, toolbar-customize: string, toolbar-title: string, toolbar-more: string, toolbar-both: string, toolbar-icons: string, toolbar-follow: string, toolbar-top: string, toolbar-bottom: string, toolbar-groups: string, toolbar-order-hint: string, toolbar-preview-hint: string, toolbar-apply: string, toolbar-reset: string,  title: string, select: string, pen: string, redact: string, rectangle: string, arrow: string, highlight: string, undo: string, redo: string, save: string, copy: string, finish: string, cancel: string, stroke: string, pen-hint: string, select-hint: string, object-hint: string, object-text-hint: string, object-delete: string, arrow-filled: string, arrow-open: string, text-edit: string, redact-hint: string, rectangle-hint: string, arrow-hint: string, highlight-hint: string, pixelate: string, pixelate-hint: string, text: string, text-hint: string, text-place: string, text-cancel: string, text-size: string, text-font: string, text-limit: string, picker: string, picker-hint: string, copy-hex: string, copy-rgb: string }
