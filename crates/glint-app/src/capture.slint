                background: shade; border-width: root.mark-color == shade ? 3px : 1px; border-color: root.mark-color == shade ? root.accent : root.muted;
                TouchArea { enabled: root.background-active && (!root.text-busy); clicked => { root.mark-color = shade; } }
            }
            Button { x: 12px; y: 108px; width: 108px; height: 28px; text: root.labels.text-place; enabled: root.background-active && (!root.text-busy); clicked => { root.action("commit-text"); } }
            text-cancel := Button { enabled: root.background-active; x: 132px; y: 108px; width: 108px; height: 28px; text: root.labels.text-cancel; clicked => { root.action("cancel-text"); } }
            Text { x: 12px; y: 142px; width: parent.width - 24px; height: 48px; text: root.text-feedback == "" ? root.labels.text-limit : root.text-feedback; color: root.ink; wrap: word-wrap; overflow: elide; }
        }
    }
    if root.loupe-visible: Rectangle {
        x: root.loupe-x * 1px; y: root.loupe-y * 1px; width: 124px; height: 158px;
        background: #161616; border-width: 1px; border-color: root.contrast ? #ffffff : #8b8b8b;
        Rectangle { x: 1px; y: 1px; width: 122px; height: 122px; background: #161616;
            Image { width: 122px; height: 122px; source: root.loupe-image; image-rendering: pixelated; }
            Rectangle { x: 60px; width: 1px; height: parent.height; background: #4295d9; }
            Rectangle { y: 60px; width: parent.width; height: 1px; background: #4295d9; }
            Rectangle { x: 55px; y: 55px; width: 12px; height: 12px; border-width: 1px; border-color: #b1daf7; }
        }
        Text { x: 2px; y: 124px; width: parent.width - 4px; height: 16px; text: root.loupe-position; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; font-size: 10px; font-weight: 400; }
        Text { x: 2px; y: 140px; width: parent.width - 4px; height: 16px; text: "HEX: " + root.loupe-hex; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; font-size: 10px; font-weight: 400; }
    }

    font-picker := FontPicker {
        visible: root.font-open;
        width: parent.width; height: parent.height;
        query <=> root.font-query;
        names: root.font-names; busy: root.font-busy; failed: root.font-failed; current: root.font-current;
        labels: {title: root.font-title, search: root.font-search, status: root.font-status, cancel: root.font-cancel, retry: root.font-retry};
        surface: root.surface; ink: root.ink; muted: root.muted; accent: root.accent;
        command(action, value) => { root.font-command(action, value); }
    }
    Rectangle {
        visible: root.output-error-open;
        z: 20; width: root.width; height: root.height; background: #00000066;
        TouchArea { }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(640px, root.width - 24px); height: min(400px, root.height - 24px);
            background: root.surface; border-width: root.contrast ? 2px : 1px; border-color: root.line; border-radius: 8px;
            FocusScope {
                width: parent.width; height: parent.height;
                key-pressed(event) => {
                    if event.text == Key.Escape { root.action("dismiss-output-error"); return accept; }
                    if event.text == Key.Tab {
                        if event.modifiers.shift {
                            if output-dismiss.has-focus { output-save.focus(); }
                            else if output-retry.has-focus { output-dismiss.focus(); }
                            else if output-alternate.has-focus { output-retry.focus(); }
                            else if root.auto-save-failed { output-alternate.focus(); }
                            else { output-retry.focus(); }
                        } else {
                            if output-dismiss.has-focus { output-retry.focus(); }
                            else if output-retry.has-focus { if root.auto-save-failed { output-alternate.focus(); } else { output-save.focus(); } }
                            else if output-alternate.has-focus { output-save.focus(); }
                            else { output-dismiss.focus(); }
                        }
                        return accept;
                    }
                    return reject;
                }
                Text { x: 16px; y: 12px; width: parent.width - 32px; height: 28px; text: root.output-error-title; color: root.ink; overflow: elide; font-size: 16px; }
                ScrollView {
                    x: 16px; y: 48px; width: parent.width - 32px; height: max(0px, parent.height - (root.auto-save-failed ? 184px : 144px)); content-width: self.visible-width;
                    Text { width: parent.width; text: root.output-error-details; color: root.ink; wrap: word-wrap; }
                }
                output-alternate := Button { visible: root.auto-save-failed; x: 16px; y: parent.height - 128px; width: parent.width - 32px; height: 32px; text: root.labels.save-elsewhere; accessible-label: root.labels.save-elsewhere; enabled: !root.busy; clicked => { root.action("save-without-auto"); } }
                output-save := Button { x: 16px; y: parent.height - 88px; width: parent.width - 32px; height: 32px; text: root.labels.save; enabled: !root.busy; clicked => { root.action("save"); } }
                output-dismiss := Button { x: 16px; y: parent.height - 48px; width: (parent.width - 40px) / 2; height: 32px; text: root.output-error-dismiss; clicked => { root.action("dismiss-output-error"); } }
                output-retry := Button { x: parent.width / 2 + 4px; y: parent.height - 48px; width: (parent.width - 40px) / 2; height: 32px; text: root.output-error-retry; enabled: !root.busy; clicked => { root.action("retry-output"); } }
            }
        }
    }
}
