                modal-cancel := Button { x: root.toolbar-modal == 1 ? parent.width - 188px : parent.width - 100px; y: parent.height - 40px; width: 88px; height: 30px; text: root.labels.cancel; clicked => { root.toolbar-command("cancel", 0, 0); } }
                modal-apply := Button { visible: root.toolbar-modal == 1; x: parent.width - 96px; y: parent.height - 40px; width: 84px; height: 30px; text: root.labels.toolbar-apply; clicked => { root.toolbar-command("apply", 0, 0); } }
