import { Theme } from "@glint_ui/theme.slint";
export component CompletionToast inherits Window {
    function sync-theme() { Theme.apply(root.dark, false, root.accent); }
    init => { root.sync-theme(); }
    changed dark => { root.sync-theme(); }
    changed accent => { root.sync-theme(); }
    title: "Glint"; no-frame: true; always-on-top: true;
    preferred-width: 380px; preferred-height: root.fallback ? 112px : 76px;
    in property <string> ui-font-family;
    default-font-family: root.ui-font-family; default-font-size: 14px;
    in property <string> message;
    in property <string> hint;
    in property <bool> fallback;
    in property <bool> dark;
    in property <color> accent;
    background: Theme.surface;
    Rectangle {
        border-width: 2px; border-color: root.accent;
        VerticalLayout { padding: 16px; spacing: 8px;
            Text { text: root.message; color: Theme.ink; wrap: word-wrap; }
            if root.fallback: Text { text: root.hint; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
        }
    }
}
