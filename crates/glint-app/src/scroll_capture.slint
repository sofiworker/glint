import { Button, ScrollView, Theme, Motion, HorizontalBox, VerticalBox, StatusLine, StatusTone, IconTool } from "@glint_ui/glint-ui.slint";
import { SpinBox } from "std-widgets.slint";
import { GlintIcons } from "@glint_ui/components/icons.slint";
export struct ScrollLabels { title: string, hint: string, capture: string, undo: string, stop: string, edit: string, cancel: string, overlap: string, accept: string, discard: string, preview: string, resume: string }
export component ScrollCaptureWindow inherits Window {
    title: root.labels.title;
    no-frame: true; always-on-top: true;
    preferred-width: 300px; preferred-height: 620px;
    min-width: 120px; min-height: 40px;
    default-font-family: Motion.ui-font-family; default-font-size: Theme.text-body;
    background: Theme.background;
    in property <ScrollLabels> labels;
    in property <bool> dark;
    in property <bool> english;
    in property <color> accent;
    init => { Theme.apply(root.dark, false, root.accent); }
    in property <bool> busy;
    in property <bool> review;
    in property <bool> repair-mode;
    in property <string> notice;
    out property <length> recovery-height: (root.notice != "" ? 52px : 0px) + (root.review && root.pending ? 42px : 0px);
    in property <bool> pending;
    in property <int> unresolved;
    in property <string> join-position;
    in property <bool> can-undo;
    in property <bool> can-finish;
    in property <string> status;
    in property <string> region-info;
    in property <bool> has-picture;
    in property <image> picture;
    in property <float> picture-width: 1;
    in property <float> picture-height: 1;
    in property <[float]> seams;
    out property <length> preview-offset: detail.viewport-y;
    in property <int> maximum-overlap: 1;
    in-out property <int> overlap;
    callback action(string);
    callback reveal-latest();
    callback reveal-first();
    callback reveal-seam(float);
    reveal-seam(position) => { detail.viewport-y = min(0px, max(detail.visible-height - root.picture-height * (detail.visible-width / 1px) / max(1, root.picture-width) * 1px, detail.visible-height / 2 - position * (detail.visible-width / 1px) / max(1, root.picture-width) * 1px)); }
    reveal-first => { detail.viewport-y = 0px; }
    reveal-latest => { detail.viewport-y = min(0px, detail.visible-height - root.picture-height * (detail.visible-width / 1px) / max(1, root.picture-width) * 1px); }
    FocusScope {
        key-pressed(event) => { if event.text == Key.Escape { root.action("cancel"); return accept; } return reject; }
        VerticalBox {
            padding: 5px; spacing: 5px;
            detail := ScrollView {
                vertical-stretch: 1; content-width: self.visible-width;
                content-height: root.picture-height * (self.visible-width / 1px) / max(1, root.picture-width) * 1px;
                Image { width: parent.width; height: root.picture-height * (self.width / 1px) / max(1, root.picture-width) * 1px; source: root.picture; image-fit: fill;
                    if root.review && root.pending && root.repair-mode: Rectangle {
                        width: parent.width; height: parent.height;
                        for seam in root.seams: Rectangle { y: seam * (parent.width / 1px) / max(1, root.picture-width) * 1px; width: parent.width; height: 2px; background: #d99c30; }
                    }
                }
                if !root.has-picture: StatusLine { width: parent.width; height: max(80px, detail.visible-height); text: root.busy ? (root.english ? "Capturing the first frame…" : "正在采集第一帧…") : (root.english ? "No frame captured. Retry or cancel." : "尚未采集到画面，请重试或取消。"); horizontal-alignment: center; vertical-alignment: center; }
            }
            if root.notice != "": StatusLine { text: root.notice; tone: StatusTone.ink; max-height: 48px; }
            if root.review && root.pending && !root.repair-mode: StatusLine {
                text: root.english ? "Some fragments need alignment." : "部分片段待拼接。";
            }
        }
    }
}
export component ScrollControlWindow inherits Window {
    no-frame: true; always-on-top: true; background: Theme.background;
    out property <length> toolbar-width: 384px;
    out property <length> toolbar-height: root.review && root.pending ? 86px : 44px;
    preferred-width: root.toolbar-width; preferred-height: root.toolbar-height;
    in property <bool> english;
    in property <bool> automatic;
    in property <bool> stopped;
    in property <bool> ready;
    in property <bool> can-undo;
    in property <bool> busy;
    in property <bool> review;
    in property <bool> pending;
    in property <bool> repair-mode;
    in property <int> unresolved;
    in property <int> maximum-overlap;
    in property <int> overlap;
    in property <bool> dark;
    in property <color> accent;
    init => { Theme.apply(root.dark, false, root.accent); }
    changed dark => { Theme.apply(root.dark, false, root.accent); }
    changed accent => { Theme.apply(root.dark, false, root.accent); }
    in property <string> status;
    callback action(string);
    callback overlap-edited(int);
    Rectangle {
        background: Theme.surface; border-radius: 8px; border-width: 1px; border-color: Theme.line;
        HorizontalLayout { y: 0px; height: 44px; padding: 5px; spacing: 4px; alignment: center;
            Button { width: 84px; height: 32px; text: !root.ready && !root.busy ? (root.english ? "Retry" : "重试采集") : root.automatic ? (root.english ? "Stop auto" : "停止自动") : (root.english ? "Auto" : "自动滚动"); enabled: !root.stopped && (root.ready || !root.busy); clicked => { root.action(root.ready ? "auto" : "capture"); } }
            Button { width: 76px; height: 32px; text: root.stopped ? (root.english ? "Resume" : "继续采集") : (root.english ? "Finish" : "结束采集"); enabled: root.ready && (!root.stopped || !root.busy); clicked => { root.action(root.stopped ? "resume" : "stop"); } }
            IconTool { icon-only: true; source: GlintIcons.undo; label: root.english ? "Undo last stitch" : "撤销上次拼接"; enabled: root.can-undo; clicked => { root.action("undo"); } }
            Rectangle { width: 1px; height: 20px; vertical-stretch: 0; background: Theme.line; }
            IconTool { icon-only: true; source: GlintIcons.pen; label: root.english ? "Edit" : "编辑"; enabled: root.ready; clicked => { root.action("edit"); } }
            IconTool { icon-only: true; source: GlintIcons.save; label: root.english ? "Save" : "保存"; enabled: root.ready; clicked => { root.action("save"); } }
            Button { width: 56px; height: 32px; text: root.english ? "Copy" : "复制"; primary: true; enabled: root.ready; clicked => { root.action("copy"); } }
            IconTool { icon-only: true; source: GlintIcons.close; label: root.english ? "Cancel capture" : "取消长截图"; clicked => { root.action("cancel"); } }
        }
        if root.review && root.pending: Rectangle { x: 5px; y: 44px; width: parent.width - 10px; height: 1px; background: Theme.line; }
        if root.review && root.pending: HorizontalLayout {
            y: 44px; height: 42px; padding: 4px; spacing: 4px; alignment: center;
            if !root.repair-mode: Button { text: root.english ? "Align fragments" : "调整拼接"; enabled: !root.busy; clicked => { root.action("repair"); } }
            if root.repair-mode: Text { text: root.english ? "Overlap" : "重叠"; color: Theme.ink; vertical-alignment: center; }
            if root.repair-mode: SpinBox { width: 72px; minimum: 0; maximum: root.maximum-overlap; value: root.overlap; enabled: !root.busy; edited(value) => { root.overlap-edited(value); } }
            if root.repair-mode && root.unresolved > 1: Button { text: root.english ? "Next" : "下一段"; enabled: !root.busy; clicked => { root.action("review-next"); } }
            if root.repair-mode: Button { text: root.english ? "Discard" : "丢弃"; enabled: !root.busy; clicked => { root.action("discard"); } }
            if root.repair-mode: Button { text: root.english ? "Apply" : "应用"; enabled: !root.busy; primary: true; clicked => { root.action("accept"); } }
        }
    }
}
