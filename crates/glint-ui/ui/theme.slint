import { Palette } from "std-widgets.slint";

// Per-window semantic tokens. Applications may override palette inputs without
// changing component sources; screenshot and annotation pixels never use these.
export global Theme {
    in-out property <bool> dark;
    in-out property <bool> contrast;
    in-out property <color> accent: #4b5cfa;
    in-out property <color> light-background: #f5f6fa;
    in-out property <color> dark-background: #141b27;
    in-out property <color> light-surface: #ffffff;
    in-out property <color> dark-surface: #1c2432;
    in-out property <color> light-sidebar: #edf0f6;
    in-out property <color> dark-sidebar: #19212f;
    in-out property <color> light-ink: #202b42;
    in-out property <color> dark-ink: #e7ebf3;
    in-out property <color> light-muted: #69758b;
    in-out property <color> dark-muted: #a8b3c8;
    in-out property <color> light-line: #dce1ea;
    in-out property <color> dark-line: #354054;
    in-out property <color> danger: #d04452;
    in-out property <color> on-accent: #ffffff;
    in-out property <length> control-radius: 6px;
    in-out property <length> focus-radius: 8px;
    in-out property <length> card-radius: 7px;
    out property <color> background: dark ? dark-background : light-background;
    out property <color> surface: dark ? dark-surface : light-surface;
    out property <color> sidebar: dark ? dark-sidebar : light-sidebar;
    out property <color> ink: dark ? dark-ink : light-ink;
    out property <color> muted: dark ? dark-muted : light-muted;
    out property <color> line: contrast ? ink : dark ? dark-line : light-line;

    public function apply(dark: bool, contrast: bool, accent: color) {
        self.dark = dark;
        self.contrast = contrast;
        self.accent = accent;
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }
}
