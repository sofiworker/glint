import { PlatformTheme } from "@glint_platform_theme";
import { Palette } from "std-widgets.slint";

// Per-window semantic tokens. Applications may override palette inputs without
// changing component sources; screenshot and annotation pixels never use these.
export global Theme {
    in-out property <bool> dark;
    in-out property <bool> contrast;
    in-out property <color> accent: #0067c0;
    in-out property <color> light-background: PlatformTheme.light-background;
    in-out property <color> dark-background: PlatformTheme.dark-background;
    in-out property <color> light-surface: PlatformTheme.light-surface;
    in-out property <color> dark-surface: PlatformTheme.dark-surface;
    in-out property <color> light-sidebar: PlatformTheme.light-sidebar;
    in-out property <color> dark-sidebar: PlatformTheme.dark-sidebar;
    in-out property <color> light-ink: PlatformTheme.light-ink;
    in-out property <color> dark-ink: PlatformTheme.dark-ink;
    in-out property <color> light-muted: PlatformTheme.light-muted;
    in-out property <color> dark-muted: PlatformTheme.dark-muted;
    in-out property <color> light-line: PlatformTheme.light-line;
    in-out property <color> dark-line: PlatformTheme.dark-line;
    in-out property <color> danger: #c94f52;
    out property <color> on-accent: foreground(accent);
    pure public function foreground(fill: color) -> color {
        return (0.2126 * linear-channel(fill.red) + 0.7152 * linear-channel(fill.green) + 0.0722 * linear-channel(fill.blue)) > 0.179 ? #000 : #fff;
    }
    pure function linear-channel(channel: int) -> float {
        let value = channel / 255.0;
        return value <= 0.04045 ? value / 12.92 : Math.pow((value + 0.055) / 1.055, 2.4);
    }
    in-out property <length> control-radius: 6px;
    in-out property <length> focus-radius: 8px;
    in-out property <length> card-radius: 7px;
    // Type scale: every window pulls sizes from here so hierarchy stays
    // consistent (display > title > heading > body > caption > micro).
    out property <length> text-display: 22px;
    out property <length> text-title: 18px;
    out property <length> text-heading: 14px;
    out property <length> text-body: 12px;
    out property <length> text-caption: 11px;
    out property <length> text-micro: 10px;
    out property <color> background: dark ? dark-background : light-background;
    out property <color> surface: dark ? dark-surface : light-surface;
    out property <color> canvas: dark ? background.darker(0.18) : sidebar;
    out property <color> sidebar: dark ? dark-sidebar : light-sidebar;
    out property <color> ink: dark ? dark-ink : light-ink;
    out property <color> muted: dark ? dark-muted : light-muted;
    out property <color> line: contrast ? ink : dark ? dark-line : light-line;

    public function apply(dark: bool, contrast: bool, accent: color) {
        self.dark = dark;
        self.contrast = contrast;
        self.accent = accent;
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }
}
