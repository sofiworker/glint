import { Motion } from "../motion.slint";

import { FluentPalette, Icons } from "styling.slint";
import { FocusBorder } from "components.slint";

export component CheckBox {
    in property <string> text;
    in property <bool> enabled <=> touch-area.enabled;
    in property <length> font-size;
    in property <int> font-weight;
    out property <bool> has-focus: focus-scope.has-focus;
    in-out property <bool> checked;

    callback toggled;

    private property <color> motion-target-text-color: FluentPalette.foreground;
    private property <color> motion-animated-text-color: self.motion-target-text-color;
    private property <color> text-color: Motion.reduced ? self.motion-target-text-color : self.motion-animated-text-color;

    min-height: max(18px, layout.min-height);
    accessible-checkable: true;
    accessible-enabled: root.enabled;
    accessible-label: root.text;
    accessible-checked <=> root.checked;
    accessible-role: checkbox;
    accessible-action-default => {
        if (root.enabled) {
           root.checked = !root.checked;
           root.toggled();
        }
    }
    forward-focus: focus-scope;

    states [
        disabled when !root.enabled : {
            border.border-color: FluentPalette.control-strong-stroke-disabled;
            background.motion-target-background: root.checked ? FluentPalette.accent-disabled : FluentPalette.control-alt-disabled;
            icon.motion-target-colorize: FluentPalette.text-accent-foreground-disabled;
            root.motion-target-text-color: FluentPalette.text-disabled;
        }
        pressed when touch-area.pressed : {
            border.border-color: FluentPalette.control-strong-stroke-disabled;
            background.motion-target-background: root.checked ? FluentPalette.tertiary-accent-background : FluentPalette.control-alt-quaternary;
            icon.motion-target-colorize: FluentPalette.text-accent-foreground-secondary;
        }
        hover when touch-area.has-hover : {
            background.motion-target-background: root.checked ?  FluentPalette.secondary-accent-background : FluentPalette.control-alt-tertiary;
        }
        checked when root.checked && root.enabled : {
            background.motion-target-background: FluentPalette.accent-background;
        }
    ]

    animate motion-animated-text-color { enabled: !Motion.reduced; duration: Motion.reduced ? 0ms : Motion.normal; }

    layout := HorizontalLayout {
        spacing: 12px;

        background := Rectangle {
            width: 18px;
            height: self.width;
            y: (parent.height - self.height) / 2;
            private property <brush> motion-target-background: FluentPalette.control-alt-secondary;
            private property <brush> motion-animated-background: self.motion-target-background;
            background: Motion.reduced ? self.motion-target-background : self.motion-animated-background;
            border-radius: 2px;

            animate motion-animated-background { enabled: !Motion.reduced; duration: Motion.reduced ? 0ms : Motion.fast; }

            border := Rectangle {
                border-color: FluentPalette.control-strong-stroke;
                border-width: root.checked ? 0 : 1px;
                border-radius: parent.border-radius;
            }

            icon := Image {
                image-fit: contain;
                visible: root.checked;
                source: Icons.check-mark;
                private property <brush> motion-target-colorize: FluentPalette.accent-foreground;
                private property <brush> motion-animated-colorize: self.motion-target-colorize;
                colorize: Motion.reduced ? self.motion-target-colorize : self.motion-animated-colorize;
                width: 12px;
                accessible-role: none;

                animate motion-animated-colorize { enabled: !Motion.reduced; duration: Motion.reduced ? 0ms : Motion.fast; }
            }
        }

        if root.text != "" : Text {
            text: root.text;
            color: root.text-color;
            font-size: root.font-size;
            font-weight: root.font-weight;
            vertical-alignment: center;
            horizontal-alignment: left;
            accessible-role: none;
        }
    }

    touch-area := TouchArea {
        clicked => {
            if (root.enabled) {
                root.checked = !root.checked;
                root.toggled();
            }
        }
    }

    focus-scope := FocusScope {
        x: 0;
        width: 0; // Do not react on clicks
        enabled <=> root.enabled;

        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                touch-area.clicked();
                return accept;
            }
            return reject;
        }
    }

    // focus border
    if root.has-focus && root.enabled : FocusBorder {
        border-radius: 4px;
    }
}
