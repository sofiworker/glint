import { Palette } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { GlintIcons } from "../../components/icons.slint";
import { ColorSchemeSelector } from "color-scheme.slint";

export struct TextStyle {
    font-size: relative-font-size,
    font-weight: int,
}

export global FluentFontSettings {
    out property <TextStyle> body-strong: { font-size: 14pt * 1rem / 14pt, font-weight: FontWeight.semi-bold };
    out property <TextStyle> title: { font-size: 28pt * 1rem / 14pt, font-weight: FontWeight.semi-bold };
}

export global FluentPalette {
    in-out property <ColorScheme> color-scheme: ColorSchemeSelector.color-scheme;
    property <bool> dark-color-scheme: {
        if (color-scheme == ColorScheme.unknown) {
            return Palette.color-scheme == ColorScheme.dark;
        }
        return color-scheme == ColorScheme.dark;
    }

    pure function accentify(default-color: color) -> color {
        let accent-color = Palette.accent-background;
        if (accent-color.alpha > 0) {
            let default-lch = default-color.to-oklch();
            let accent-lch = accent-color.to-oklch();
            return oklch(default-lch.lightness, accent-lch.chroma, accent-lch.hue);
        }
        return default-color;
    }

    // base palette
    out property <brush> background: Theme.background;
    out property <brush> foreground: Theme.ink;
    out property <brush> alternate-background: Theme.sidebar;
    out property <brush> alternate-foreground: Theme.ink;
    out property <brush> control-background: Theme.surface;
    out property <brush> control-foreground: Theme.ink;
    out property <brush> accent-background: Theme.accent;
    out property <brush> accent-foreground: Theme.on-accent;
    out property <brush> selection-background: Theme.accent;
    out property <brush> selection-foreground: Theme.on-accent;
    out property <brush> border: Theme.line;

    // additional palette
    out property <brush> secondary-accent-background: accent-background.with-alpha(0.9);
    out property <brush> tertiary-accent-background: accent-background.with-alpha(0.8);
    out property <brush> accent-disabled: dark-color-scheme ? #FFFFFF29 : #00000038;
    out property <brush> accent-control-border: dark-color-scheme ? @linear-gradient(180deg, #FFFFFF14 90.67%, #00000024 100%) : @linear-gradient(180deg, #FFFFFF14 90.67%, #00000066 100%);
    out property <brush> control-border: Theme.line;
    out property <brush> text-accent-foreground-secondary: dark-color-scheme ? #00000080 : #FFFFFFB3;
    out property <brush> text-accent-foreground-disabled: dark-color-scheme ? #FFFFFF87 : #FFFFFF;
    out property <brush> text-secondary: Theme.muted;
    out property <brush> text-tertiary: dark-color-scheme ? #FFFFFF8A : #00000073;
    out property <brush> text-disabled: dark-color-scheme ? #FFFFFF5E : #0000005E;
    out property <brush> text-control-border: Theme.line;
    out property <brush> control-secondary: Theme.sidebar;
    out property <brush> control-tertiary: Theme.sidebar;
    out property <brush> control-disabled: Theme.sidebar;
    out property <brush> control-alt-secondary: dark-color-scheme ? #0000001A : #00000005;
    out property <brush> control-alt-tertiary: dark-color-scheme ? #FFFFFF0A : #0000000F;
    out property <brush> control-alt-quaternary: dark-color-scheme ? #FFFFFF12 : #00000017;
    out property <brush> control-alt-disabled: transparent;
    out property <brush> control-strong-stroke: dark-color-scheme ? #FFFFFF99 : #00000099;
    out property <brush> control-strong-stroke-disabled: dark-color-scheme ? #FFFFFF29 : #00000038;
    out property <brush> control-solid: dark-color-scheme ? #454545 : #FFFFFF;
    out property <brush> circle-border: dark-color-scheme ? @linear-gradient(180deg, #FFFFFF17 0%, #FFFFFF12 100%) : @linear-gradient(180deg, #0000000F 0%, #00000029 100%);
    out property <brush> control-input-active: Theme.surface;
    out property <brush> focus-stroke-inner: Theme.surface;
    out property <brush> focus-stroke-outer: Theme.accent;
    out property <brush> control-background-stroke-flyout: Theme.line;
    out property <brush> sub-title-secondary: dark-color-scheme ? #FFFFFF0F : #0000000A;
    out property <brush> sub-title-tertiary: dark-color-scheme ? #FFFFFF0A : #00000005;
    out property <brush> shadow: dark-color-scheme ? #00000042 : #00000024;
    out property <brush> subtle: dark-color-scheme ? #FFFFFF0F : #0000000A;
    out property <brush> subtle-secondary: dark-color-scheme ? #FFFFFF0F : #0000000A;
    out property <brush> subtle-tertiary: dark-color-scheme ? #FFFFFF0A : #00000005;
    out property <brush> divider: Theme.line;
    out property <brush> layer-on-mica-base-alt: Theme.surface;
    out property <brush> layer-on-mica-base-alt-secondary: dark-color-scheme ? #FFFFFF0F : #0000000A;
    out property <brush> card-stroke: Theme.line;
    out property <brush> state: dark-color-scheme ? #ffffff : #000000;
    out property <brush> state-secondary: dark-color-scheme ? #000000 : #ffffff;
}

export global Icons {
    out property <image> arrow-down: GlintIcons.arrow-down;
    out property <image> arrow-up: GlintIcons.arrow-up;
    out property <image> check-mark: GlintIcons.check;
    out property <image> chevron-down: GlintIcons.down;
    out property <image> chevron-up: GlintIcons.up;
    out property <image> down: GlintIcons.down;
    out property <image> dropdown: GlintIcons.down;
    out property <image> left: GlintIcons.left;
    out property <image> right: GlintIcons.right;
    out property <image> up: GlintIcons.up;
    out property <image> keyboard: GlintIcons.keyboard;
    out property <image> clock: GlintIcons.clock;
    out property <image> arrow-back: GlintIcons.left;
    out property <image> arrow-forward: GlintIcons.right;
    out property <image> edit: GlintIcons.pen;
    out property <image> calendar: GlintIcons.calendar;
}

export global FluentSizeSettings {
    out property <length> item-height: 40px;
}
