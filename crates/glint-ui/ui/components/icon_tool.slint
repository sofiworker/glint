import { Theme } from "../theme.slint";
import { ToolbarAssets } from "toolbar_editor.slint";

// Icon-over-caption tool button shared by the floating capture windows.
// Previously each window defined its own variant with drifting metrics.
export component IconTool inherits Rectangle {
    in property <int> image: 9;
    in property <image> source: ToolbarAssets.images[root.image];
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> icon-only;
    in property <bool> primary;
    in property <bool> active;
    callback clicked();
    height: root.icon-only ? 32px : 42px;
    min-width: root.icon-only ? 32px : 42px;
    accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    border-radius: 5px;
    background: root.primary ? Theme.accent : root.active || touch.has-hover ? Theme.accent.with-alpha(0.15) : transparent;
    border-width: keys.has-focus ? 1px : 0px; border-color: Theme.accent;
    forward-focus: keys;
    Image { x: (parent.width - 18px) / 2; y: root.icon-only ? (parent.height - 18px) / 2 : 4px; width: 18px; height: 18px; source: root.source; colorize: root.primary ? Theme.on-accent : root.active ? Theme.accent : Theme.ink; opacity: root.enabled ? 1 : 0.4; }
    if !root.icon-only: Text { y: 25px; width: parent.width; height: 15px; text: root.label; color: Theme.muted; font-size: Theme.text-micro; horizontal-alignment: center; overflow: elide; }
    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.clicked(); return accept; } return reject; }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { keys.focus(); root.clicked(); } }
}
