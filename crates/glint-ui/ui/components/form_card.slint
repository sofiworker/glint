import { Theme } from "../theme.slint";

// Presentation shell only: field type, configuration keys and draft actions are
// owned by the page. Children share the card's coordinates, as before extraction.
export component FormCard inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> compact;
    in property <bool> full-width-title;
    in property <bool> description-visible: true;
    out property <length> title-height: heading.preferred-height;
    out property <length> title-bottom: heading.y + heading.preferred-height;
    out property <length> description-height: detail.preferred-height;
    out property <length> description-bottom: detail.y + detail.preferred-height;
    vertical-stretch: 0;
    background: Theme.surface;
    border-width: Theme.contrast ? 2px : 1px;
    border-color: Theme.line;
    border-radius: Theme.card-radius;
    heading := Text {
        x: 18px; y: 16px;
        width: root.full-width-title || root.compact ? parent.width - 36px : parent.width - 316px;
        text: root.title; color: Theme.ink; font-weight: 400; wrap: word-wrap;
    }
    detail := Text {
        visible: root.description-visible && root.description != "";
        x: 18px; y: max(root.compact ? 0px : 46px, root.title-bottom + 8px);
        width: root.compact ? parent.width - 36px : parent.width - 316px;
        text: root.description; color: Theme.muted; font-size: 12px; wrap: word-wrap;
    }
    @children
}
