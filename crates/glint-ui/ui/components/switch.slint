import { Theme } from "../theme.slint";
import { Motion } from "../widgets/motion.slint";

// WinUI-style toggle switch for binary settings that apply immediately.
// Replaces checkboxes on settings pages per the platform guidance.
export component GlintSwitch inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <color> accent: Theme.accent;
    in property <string> label;
    callback toggled(bool);
    width: 44px; height: 22px;
    border-radius: 11px;
    forward-focus: keys;
    accessible-role: checkbox; accessible-checked: root.checked;
    accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.toggled(!root.checked); } }
    background: root.checked
        ? (root.enabled ? root.accent : root.accent.with-alpha(0.35))
        : (root.enabled ? Theme.line : Theme.line.with-alpha(0.5));
    border-width: root.checked ? 0px : 1px;
    border-color: Theme.muted;
    animate background { duration: Motion.reduced ? 0ms : 120ms; }
    thumb := Rectangle {
        x: root.checked ? 44px - 16px - 3px : 3px;
        y: (22px - 16px) / 2;
        width: 16px; height: 16px; border-radius: 8px;
        background: root.checked ? Theme.on-accent : Theme.muted;
        animate x { duration: Motion.reduced ? 0ms : 120ms; easing: ease-out; }
    }
    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                root.toggled(!root.checked);
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { keys.focus(); root.toggled(!root.checked); } }
    if keys.has-focus: Rectangle { x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px;
        border-radius: 13px; border-width: 1px; border-color: root.accent; background: transparent; }
}
